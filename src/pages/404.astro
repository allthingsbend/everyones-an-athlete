---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Page Not Found';
const description = 'The page you are looking for could not be found.';
---
<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container">
      <div class="eyebrow">404</div>
      <h1>Page not found.</h1>
      <p class="lead">This page may have moved. Start from the homepage or browse our practical health and performance guides.</p>
      <div class="hero-actions">
        <a class="btn" href="/">Go home</a>
        <a class="btn secondary" href="/guides/">Explore the guides</a>
      </div>
    </div>
  </section>
</BaseLayout>
