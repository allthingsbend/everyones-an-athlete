---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Page Not Found';
const description = 'The page you are looking for could not be found.';
---
<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container">
      <div class="eyebrow">404</div>
      <h1>Page not found.</h1>
      <p class="lead">This page may have moved. Start with the main guide or browse the wellness content calendar.</p>
      <div class="hero-actions">
        <a class="btn" href="/">Go home</a>
        <a class="btn secondary" href="/content-calendar/">View content calendar</a>
      </div>
    </div>
  </section>
</BaseLayout>
