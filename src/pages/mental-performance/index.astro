---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicHubHero from '../../components/TopicHubHero.astro';
const title = 'Mental Performance App for Everyone';
const description = 'Mental performance training for athletes and everyday movers, including body awareness, breathing, reflection and mindset skills.';
const features = ['Breathing', 'Focus', 'Reflection', 'Consistency'];
---
<BaseLayout title={title} description={description}>
  <TopicHubHero
    eyebrow="Mental Performance"
    heading="Train the skills behind consistency."
    lead="Use breathing, awareness and reflection to support focus, recovery and better decisions around training and everyday life."
    primaryLabel="Explore Mindset Guides"
    primaryHref="/mental-performance/mental-performance-training-for-athletes/"
    secondaryLabel="Try Breathing Exercises"
    secondaryHref="/mental-performance/breathing-exercises-for-athletes/"
    {features}
    accent="purple"
    image="/images/app/screenshot-3.png"
    image2="/images/app/screenshot-6.png"
    visualTitle="Mental skills are trainable."
    visualText="Simple practices can help you notice what is happening, reset and make a better next decision."
  />

  <section class="section hub-intro-section">
    <div class="container hub-intro-grid">
      <div>
        <div class="eyebrow purple-text">Mindset in practice</div>
        <h2>Useful tools, not motivational noise.</h2>
      </div>
      <p>Mental performance is not about pretending every day feels easy. It is about building simple skills you can use when attention, stress, confidence or consistency start to drift.</p>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="grid three">
        <article class="card hub-feature-card"><span class="pill purple">Awareness</span><h3>Notice what is happening</h3><p>Pay attention to tension, fatigue, breathing and emotional state before automatically pushing harder.</p></article>
        <article class="card hub-feature-card"><span class="pill purple">Breathing</span><h3>Create a reset</h3><p>Use short breathing practices before training, between efforts or when you need to downshift.</p></article>
        <article class="card hub-feature-card"><span class="pill purple">Reflection</span><h3>Learn from the pattern</h3><p>Look at what helps or hurts consistency so your routine can fit real life instead of chasing perfection.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-hub">
      <div>
        <div class="eyebrow">Why it matters</div>
        <h2>Mental performance sits inside the training system.</h2>
        <p>Physical training is easier to see, but mental performance shapes how people show up, handle discomfort, recover from setbacks and make decisions when plans change.</p>
        <div class="callout purple-border">Mental performance is not only for elite athletes. It can help anyone who wants to train, recover and live with more consistency.</div>
      </div>
      <div class="hub-stack">
        <a class="card" href="/mental-performance/mental-performance-training-for-athletes/"><span class="pill purple">Guide</span><h3>Mental Performance Training for Athletes</h3><p>Focus, confidence, breathing and awareness in one practical guide.</p></a>
        <a class="card" href="/mental-performance/breathing-exercises-for-athletes/"><span class="pill purple">Routine</span><h3>Breathing Exercises for Athletes</h3><p>Practical routines for preparation, between-effort resets and recovery.</p></a>
        <a class="card" href="/fitness-apps/all-in-one-physical-mental-health-app/"><span class="pill purple">App</span><h3>Physical + Mental Health App</h3><p>Why physical and mental wellness tools work better when they are connected.</p></a>
      </div>
    </div>
  </section>

  <style>
    .hub-intro-section { background:#fff; }
    .hub-intro-grid { display:grid; grid-template-columns:1fr .8fr; gap:48px; align-items:end; }
    .hub-intro-grid h2 { margin:8px 0 0; }
    .hub-intro-grid > p { color:var(--muted); margin:0; max-width:520px; justify-self:end; }
    .hub-feature-card { min-height:230px; }
    .split-hub { display:grid; grid-template-columns:.9fr 1.1fr; gap:46px; align-items:start; }
    .split-hub h2 { font-size:clamp(2.2rem,4vw,3.6rem); line-height:1; letter-spacing:-.05em; }
    .split-hub > div > p { color:var(--muted); font-size:1.08rem; }
    .hub-stack { display:grid; gap:14px; }
    @media(max-width:820px){ .hub-intro-grid,.split-hub{grid-template-columns:1fr}.hub-intro-grid>p{justify-self:start}.grid.three{grid-template-columns:1fr} }
  </style>
</BaseLayout>