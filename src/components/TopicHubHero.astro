---
const {
  eyebrow,
  heading,
  lead,
  primaryLabel = 'Explore the App',
  primaryHref = '/fitness-apps/',
  secondaryLabel = 'Browse Guides',
  secondaryHref = '/guides/',
  features = [],
  accent = 'teal',
  image = '/images/app/screenshot-1.png',
  image2 = '/images/app/screenshot-2.png',
  visualTitle = 'Built to follow',
  visualText = 'Clear direction, useful video guidance and practical support around the work.'
} = Astro.props;
---
<section class={`topic-hero topic-${accent}`}>
  <div class="container topic-hero-grid">
    <div class="topic-copy">
      <div class="topic-kicker"><span></span>{eyebrow}</div>
      <h1>{heading}</h1>
      <p class="topic-lead">{lead}</p>
      <div class="topic-actions">
        <a class="btn" href={primaryHref}>{primaryLabel} <span>→</span></a>
        <a class="topic-secondary" href={secondaryHref}>{secondaryLabel}</a>
      </div>
      {features.length > 0 && (
        <div class="topic-features" aria-label={`${eyebrow} highlights`}>
          {features.map((feature) => <span>{feature}</span>)}
        </div>
      )}
    </div>

    <div class="topic-visual" aria-label={`${eyebrow} app preview`}>
      <div class="topic-visual-grid" aria-hidden="true"></div>
      <div class="topic-visual-copy">
        <span>{eyebrow}</span>
        <strong>{visualTitle}</strong>
        <p>{visualText}</p>
      </div>
      <img class="topic-phone topic-phone-main" src={image} alt={`${eyebrow} app preview`} loading="eager" />
      <img class="topic-phone topic-phone-side" src={image2} alt={`${eyebrow} secondary app preview`} loading="lazy" />
    </div>
  </div>
</section>

<style>
  .topic-hero {
    --hub-accent: #10998d;
    --hub-soft: #eaf6f3;
    position: relative;
    overflow: hidden;
    padding: 72px 0 66px;
    background:
      radial-gradient(circle at 84% 12%, color-mix(in srgb, var(--hub-accent) 14%, transparent), transparent 26%),
      linear-gradient(180deg, #f8faf8 0%, #fbfcfa 100%);
    border-bottom: 1px solid var(--line);
  }
  .topic-purple { --hub-accent: #7157d9; --hub-soft: #f4f1ff; }
  .topic-orange { --hub-accent: #e99b2f; --hub-soft: #fff7e8; }
  .topic-coral { --hub-accent: #ef746d; --hub-soft: #fff4f2; }
  .topic-dark { --hub-accent: #8ee0d5; --hub-soft: #0b2928; }

  .topic-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(420px, 1.05fr);
    gap: 62px;
    align-items: center;
  }
  .topic-kicker {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--hub-accent);
    font-weight: 850;
    font-size: 0.76rem;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .topic-kicker span { width: 8px; height: 8px; border-radius: 50%; background: var(--hub-accent); box-shadow: 0 0 0 5px color-mix(in srgb, var(--hub-accent) 11%, transparent); }
  .topic-copy h1 {
    font-size: clamp(3rem, 5.8vw, 5.8rem);
    line-height: .94;
    letter-spacing: -.068em;
    margin: 18px 0 20px;
    max-width: 820px;
  }
  .topic-lead { max-width: 680px; color: #566668; font-size: 1.14rem; line-height: 1.55; margin: 0; }
  .topic-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; margin-top: 26px; }
  .topic-actions .btn { background: #0b2928; }
  .topic-actions .btn span { color: #8ee0d5; }
  .topic-secondary { color: var(--teal-dark); font-weight: 800; }
  .topic-features { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }
  .topic-features span { border: 1px solid var(--line); background: rgba(255,255,255,.82); border-radius: 999px; padding: 7px 10px; color: #5c6b6d; font-size: .78rem; font-weight: 780; }

  .topic-visual {
    position: relative;
    min-height: 510px;
    overflow: hidden;
    border-radius: 34px;
    background: #0b2928;
    box-shadow: 0 34px 80px rgba(11,41,40,.20);
  }
  .topic-visual::before { content:""; position:absolute; width:300px; height:300px; border-radius:50%; right:-70px; top:-90px; background:color-mix(in srgb, var(--hub-accent) 22%, transparent); filter:blur(10px); }
  .topic-visual-grid { position:absolute; inset:0; opacity:.08; background-image:linear-gradient(rgba(255,255,255,.25) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.25) 1px,transparent 1px); background-size:48px 48px; }
  .topic-visual-copy { position:absolute; z-index:6; left:28px; top:28px; width:42%; color:#fff; }
  .topic-visual-copy > span { color:var(--hub-accent); font-size:.7rem; font-weight:850; text-transform:uppercase; letter-spacing:.12em; }
  .topic-visual-copy strong { display:block; font-size:1.65rem; line-height:1.02; letter-spacing:-.04em; margin:8px 0; }
  .topic-visual-copy p { color:#b8ccca; font-size:.88rem; line-height:1.45; margin:0; }
  .topic-phone { position:absolute; width:42%; border-radius:24px; border:5px solid rgba(255,255,255,.95); box-shadow:0 26px 55px rgba(0,0,0,.34); }
  .topic-phone-main { right:12%; top:44px; z-index:4; }
  .topic-phone-side { right:-5%; top:168px; transform:rotate(7deg); opacity:.92; }

  @media (max-width: 980px) {
    .topic-hero-grid { grid-template-columns:1fr; gap:34px; }
    .topic-visual { max-width:700px; width:100%; }
  }
  @media (max-width: 620px) {
    .topic-hero { padding:38px 0 42px; }
    .topic-copy h1 { font-size:clamp(2.7rem, 12vw, 4rem); line-height:.96; margin:14px 0 16px; }
    .topic-lead { font-size:1rem; }
    .topic-actions { margin-top:20px; }
    .topic-features { margin-top:20px; overflow-x:auto; flex-wrap:nowrap; padding-bottom:2px; }
    .topic-features span { white-space:nowrap; }
    .topic-visual { min-height:340px; border-radius:26px; }
    .topic-visual-copy { left:20px; top:20px; width:45%; }
    .topic-visual-copy strong { font-size:1.28rem; }
    .topic-visual-copy p { display:none; }
    .topic-phone-main { width:48%; right:9%; top:28px; }
    .topic-phone-side { width:43%; right:-10%; top:132px; }
  }
</style>