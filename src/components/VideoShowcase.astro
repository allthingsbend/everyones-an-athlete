---
const {
  eyebrow = 'Exercise videos',
  heading = 'See the movement before you do it.',
  intro = 'Short, clear demonstrations you can play right here without leaving the site.',
  compact = false
} = Astro.props;

const videos = [
  { name: 'Deadlift', id: 'l2Usc4w8094', detail: 'Hinge pattern · Strength' },
  { name: 'Step Ups', id: 'vUMOMFyQbLo', detail: 'Single-leg · Lower body' },
  { name: 'Bench Press', id: 'x9FXYhM85jg', detail: 'Press · Upper body' }
];
---
<section class={`video-showcase ${compact ? 'video-showcase-compact' : ''}`}>
  <div class="video-showcase-head">
    <div>
      <span>{eyebrow}</span>
      <h2>{heading}</h2>
    </div>
    <p>{intro}</p>
  </div>
  <div class="video-showcase-grid">
    {videos.map((video) => (
      <article class="exercise-video">
        <div class="exercise-frame">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${video.id}?rel=0`}
            title={`${video.name} exercise demonstration`}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen>
          </iframe>
        </div>
        <div class="exercise-meta">
          <div><strong>{video.name}</strong><small>{video.detail}</small></div>
          <span>Play</span>
        </div>
      </article>
    ))}
  </div>
  <a class="video-channel-link" href="https://www.youtube.com/@everyonesanathlete." rel="noopener noreferrer">See the full video library on YouTube →</a>
</section>

<style>
.video-showcase{margin:48px 0 56px;padding:30px;border:1px solid var(--line);border-radius:28px;background:#f7f9fc}.video-showcase-head{display:grid;grid-template-columns:1fr .8fr;gap:30px;align-items:end;margin-bottom:22px}.video-showcase-head>div>span{display:block;color:var(--teal-dark);font-size:.72rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase;margin-bottom:8px}.video-showcase h2{margin:0;font-size:clamp(2rem,3vw,3rem);line-height:1;letter-spacing:-.045em}.video-showcase-head p{margin:0;color:var(--muted);max-width:480px;justify-self:end}.video-showcase-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.exercise-video{overflow:hidden;background:#fff;border:1px solid var(--line);border-radius:18px}.exercise-frame{position:relative;aspect-ratio:16/10;background:#273750}.exercise-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}.exercise-meta{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 14px}.exercise-meta strong{display:block;font-size:.98rem}.exercise-meta small{display:block;color:var(--muted);font-size:.72rem;margin-top:2px}.exercise-meta>span{color:var(--teal-dark);font-size:.74rem;font-weight:850}.video-channel-link{display:inline-block;margin-top:18px;color:var(--teal-dark);font-size:.84rem;font-weight:800}.video-showcase-compact{margin:38px 0 46px}
@media(max-width:760px){.video-showcase{padding:18px;margin:34px 0 40px;border-radius:22px}.video-showcase-head{grid-template-columns:1fr;gap:10px}.video-showcase-head p{justify-self:start}.video-showcase-grid{grid-template-columns:1fr}.exercise-frame{aspect-ratio:16/9}}
</style>