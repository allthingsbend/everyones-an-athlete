---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Fitness, Recovery, Nutrition & Wellness App';
const description = 'Everyone’s an Athlete connects guided workouts, exercise videos, recovery, mobility and practical nutrition in one approachable fitness system.';

const videos = [
  { name: 'Deadlift', schemaName: 'Deadlift Exercise Demonstration', description: 'A strength movement demonstration focused on controlled deadlift setup and execution.', id: 'l2Usc4w8094' },
  { name: 'Step Ups', schemaName: 'Step Ups Exercise Demonstration', description: 'A lower-body movement demonstration for strength, balance and single-leg control.', id: 'vUMOMFyQbLo' },
  { name: 'Bench Press', schemaName: 'Bench Press Exercise Demonstration', description: 'An upper-body strength demonstration focused on pressing mechanics and control.', id: 'x9FXYhM85jg' }
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'Everyone’s an Athlete', url: new URL('/', Astro.site).toString(), description },
    ...videos.map((video) => ({
      '@type': 'VideoObject',
      name: video.schemaName,
      description: video.description,
      thumbnailUrl: `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`,
      embedUrl: `https://www.youtube.com/embed/${video.id}`,
      contentUrl: `https://www.youtube.com/watch?v=${video.id}`
    }))
  ]
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="home-hero">
    <div class="container home-hero-grid">
      <div class="hero-copy">
        <div class="launch-pill"><span></span> App in development</div>
        <h1>Your workout. Your recovery. Your nutrition. <em>One app.</em></h1>

        <div class="mobile-app-glimpse" aria-label="Everyone’s an Athlete app preview">
          <div class="glimpse-copy">
            <span>Today</span>
            <strong>Full Body Strength</strong>
            <small>Guided workout · Video demos</small>
          </div>
          <img class="glimpse-main" src="/images/app/screenshot-1.png" alt="Everyone’s an Athlete app home screen" loading="eager" />
          <img class="glimpse-side" src="/images/app/screenshot-2.png" alt="Everyone’s an Athlete workout screen" loading="eager" />
        </div>

        <p class="hero-lead">Follow guided workouts with clear exercise videos, then support the work with practical recovery and nutrition guidance.</p>
        <div class="hero-actions">
          <a class="btn hero-primary" href="/fitness-apps/">Explore the App <span>→</span></a>
          <a class="hero-secondary" href="/guides/">Browse free guides</a>
        </div>
        <div class="hero-proof" aria-label="App features">
          <span>Workout plans</span><i></i><span>Video demos</span><i></i><span>Recovery</span><i></i><span>Nutrition</span>
        </div>
      </div>

      <div class="product-stage" aria-label="Everyone’s an Athlete app preview">
        <div class="stage-grid" aria-hidden="true"></div>
        <div class="stage-label stage-label-one">Guided workouts</div>
        <div class="stage-label stage-label-two">Recovery</div>
        <div class="stage-label stage-label-three">Nutrition + habits</div>
        <img class="stage-phone stage-phone-main" src="/images/app/screenshot-1.png" alt="Everyone’s an Athlete app home screen" loading="eager" />
        <img class="stage-phone stage-phone-left" src="/images/app/screenshot-2.png" alt="Everyone’s an Athlete training screen" loading="eager" />
        <img class="stage-phone stage-phone-right" src="/images/app/screenshot-3.png" alt="Everyone’s an Athlete wellness screen" loading="eager" />
      </div>
    </div>
  </section>

  <div class="signal-bar">
    <div class="container signal-inner">
      <span>Strength</span><i></i><span>Movement</span><i></i><span>Recovery</span><i></i><span>Nutrition</span><i></i><span>Mental Performance</span>
    </div>
  </div>

  <section class="section system-section">
    <div class="container">
      <div class="section-intro">
        <div><div class="eyebrow">The system</div><h2>More than a workout library.</h2></div>
        <p>Know what to train today, how to do it, and what supports the work around it.</p>
      </div>
      <div class="system-grid">
        <a class="system-card training-card" href="/training/"><span>01</span><div><h3>Training</h3><p>Structured workouts, exercise videos and progression.</p></div><b>↗</b></a>
        <a class="system-card recovery-card" href="/recovery/"><span>02</span><div><h3>Recovery</h3><p>Mobility, warmups, cooldowns and easier days.</p></div><b>↗</b></a>
        <a class="system-card nutrition-card" href="/nutrition/"><span>03</span><div><h3>Nutrition</h3><p>Practical fueling, protein, hydration and meal guidance.</p></div><b>↗</b></a>
        <a class="system-card mindset-card" href="/mental-performance/"><span>04</span><div><h3>Mindset</h3><p>Breathing, awareness and consistency skills.</p></div><b>↗</b></a>
      </div>
    </div>
  </section>

  <section class="showcase-section">
    <div class="container showcase-shell">
      <div class="showcase-copy">
        <div class="eyebrow showcase-eyebrow">Inside the app</div>
        <h2>See it. Follow it. Keep going.</h2>
        <p>Clear daily direction without digging through an endless exercise library.</p>
        <a href="/fitness-apps/">See how the app works <span>→</span></a>
      </div>
      <div class="screen-showcase">
        <figure class="screen screen-one"><img src="/images/app/screenshot-4.png" alt="Everyone’s an Athlete app screen" loading="lazy" /></figure>
        <figure class="screen screen-two"><img src="/images/app/screenshot-5.png" alt="Everyone’s an Athlete app feature screen" loading="lazy" /></figure>
        <figure class="screen screen-three"><img src="/images/app/screenshot-6.png" alt="Everyone’s an Athlete app wellness screen" loading="lazy" /></figure>
      </div>
    </div>
  </section>

  <section class="section path-section">
    <div class="container">
      <div class="section-intro compact-intro"><div><div class="eyebrow">Choose your path</div><h2>Built for people. Useful for teams.</h2></div></div>
      <div class="path-grid">
        <a class="path-card path-personal" href="/fitness-apps/"><div class="path-top"><span>For you</span><b>↗</b></div><div><h3>A fitness app you can actually follow.</h3><p>Guided workouts, video demos, recovery and nutrition in one place.</p></div></a>
        <a class="path-card path-corporate" href="/corporate-wellness/"><div class="path-top"><span>For teams</span><b>↗</b></div><div><h3>Corporate wellness people can actually use.</h3><p>Practical support for office, remote and hybrid teams.</p></div></a>
      </div>
    </div>
  </section>

  <section class="section video-section">
    <div class="container">
      <div class="section-intro"><div><div class="eyebrow">Watch &amp; learn</div><h2>Clear exercise demos.</h2></div><a class="section-link" href="https://www.youtube.com/@everyonesanathlete" rel="noopener noreferrer">YouTube channel →</a></div>
      <div class="video-grid">
        {videos.map((video) => (
          <article class="video-card">
            <div class="video-wrapper"><iframe src={`https://www.youtube.com/embed/${video.id}`} title={video.schemaName} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>
            <div class="video-title"><h3>{video.name}</h3><span>Watch ↗</span></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section guides-section">
    <div class="container">
      <div class="section-intro"><div><div class="eyebrow">Useful right now</div><h2>Start with a practical guide.</h2></div><a class="section-link" href="/guides/">View all guides →</a></div>
      <div class="guide-tiles">
        <a href="/training/beginner-strength-training-program/"><span>Training</span><strong>Beginner Strength Training Program</strong><b>01</b></a>
        <a href="/recovery/10-minute-mobility-routine/"><span>Recovery</span><strong>10-Minute Full-Body Mobility Routine</strong><b>02</b></a>
        <a href="/nutrition/why-nutrition-is-important-for-athletes/"><span>Nutrition</span><strong>Why Nutrition Is Important for Athletes</strong><b>03</b></a>
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container final-cta-inner"><div><span class="eyebrow final-eyebrow">Everyone’s an Athlete</span><h2>Know what to do next.</h2></div><div class="final-actions"><a class="btn final-button" href="/contact/">Get Launch Updates</a><a href="/about/">Why we’re building it →</a></div></div>
  </section>

  <style>
    .home-hero{position:relative;overflow:hidden;padding:72px 0 78px;background:radial-gradient(circle at 76% 16%,rgba(16,153,141,.13),transparent 25%),radial-gradient(circle at 8% 92%,rgba(233,155,47,.10),transparent 22%),#f8faf8}
    .home-hero::before{content:"";position:absolute;width:560px;height:560px;border:1px solid rgba(16,153,141,.10);border-radius:50%;right:-240px;top:-250px}
    .home-hero-grid{display:grid;grid-template-columns:minmax(0,.98fr) minmax(440px,1.02fr);gap:64px;align-items:center}
    .launch-pill{display:inline-flex;align-items:center;gap:9px;padding:7px 11px;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.76);font-weight:780;font-size:.82rem;color:#526264}
    .launch-pill span{width:8px;height:8px;border-radius:50%;background:var(--teal);box-shadow:0 0 0 5px rgba(16,153,141,.09)}
    .hero-copy h1{font-size:clamp(3.5rem,6.3vw,6.25rem);line-height:.92;letter-spacing:-.072em;margin:22px 0;max-width:820px}
    .hero-copy h1 em{display:block;color:var(--teal-dark);font-style:normal}
    .hero-lead{max-width:650px;color:#566668;font-size:1.16rem;line-height:1.52;margin:0}
    .hero-actions{align-items:center}
    .hero-primary{background:var(--teal-deep)}
    .hero-primary span{margin-left:5px;color:#8ee0d5}
    .hero-secondary{font-size:.9rem;font-weight:800;color:var(--teal-dark);padding:10px 5px}
    .hero-proof{display:flex;align-items:center;gap:10px;margin-top:28px;color:#637173;font-size:.76rem;font-weight:780;white-space:nowrap}
    .hero-proof i{width:3px;height:3px;border-radius:50%;background:#a8b7b4}
    .mobile-app-glimpse{display:none}
    .product-stage{position:relative;height:610px;border-radius:38px;background:#0b2928;box-shadow:0 40px 90px rgba(11,41,40,.2);overflow:hidden;isolation:isolate}
    .product-stage::before{content:"";position:absolute;width:380px;height:380px;border-radius:50%;background:rgba(70,196,182,.15);filter:blur(20px);right:-80px;top:-100px}
    .product-stage::after{content:"";position:absolute;width:280px;height:280px;border-radius:50%;background:rgba(233,155,47,.13);filter:blur(12px);left:-90px;bottom:-90px}
    .stage-grid{position:absolute;inset:0;opacity:.1;background-image:linear-gradient(rgba(255,255,255,.25) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.25) 1px,transparent 1px);background-size:54px 54px;mask-image:linear-gradient(to bottom,#000,transparent 90%)}
    .stage-phone{position:absolute;width:43%;border-radius:28px;border:6px solid rgba(255,255,255,.94);box-shadow:0 28px 62px rgba(0,0,0,.34);z-index:3}
    .stage-phone-main{width:49%;left:25%;top:52px;z-index:5}.stage-phone-left{left:-5%;top:165px;transform:rotate(-7deg)}.stage-phone-right{right:-5%;top:174px;transform:rotate(7deg)}
    .stage-label{position:absolute;z-index:7;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.10);backdrop-filter:blur(12px);color:#e7f3f1;border-radius:999px;padding:8px 11px;font-size:.76rem;font-weight:780}.stage-label-one{left:7%;top:42px}.stage-label-two{right:8%;top:78px}.stage-label-three{right:10%;bottom:28px}
    .signal-bar{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#fff}.signal-inner{min-height:58px;display:flex;align-items:center;justify-content:center;gap:22px;color:#5a696b;font-size:.81rem;font-weight:780}.signal-inner i{width:4px;height:4px;border-radius:50%;background:#b8c7c4}
    .section-intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,.55fr);gap:48px;align-items:end;margin-bottom:34px}.section-intro h2{margin:8px 0 0}.section-intro>p{color:var(--muted);margin:0;max-width:480px;justify-self:end}.compact-intro{grid-template-columns:1fr}
    .system-section{background:#fff}.system-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.system-card{position:relative;min-height:190px;overflow:hidden;display:grid;grid-template-columns:44px 1fr auto;gap:18px;align-items:end;border:1px solid var(--line);border-radius:26px;padding:26px;transition:transform 180ms ease,box-shadow 180ms ease}.system-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-md)}.system-card>span{align-self:start;font-size:.72rem;font-weight:850;letter-spacing:.08em;opacity:.7}.system-card h3{font-size:1.65rem;line-height:1;letter-spacing:-.035em;margin:0 0 8px}.system-card p{color:#627173;margin:0;max-width:390px;font-size:.94rem}.system-card>b{align-self:start;font-weight:500;opacity:.62}.training-card{color:#0c756e;background:#eff8f5}.recovery-card{color:#b85a54;background:#fff4f2}.nutrition-card{color:#a76a14;background:#fff7e8}.mindset-card{color:#6049bd;background:#f4f1ff}
    .showcase-section{padding:0 0 78px;background:#fff}.showcase-shell{min-height:620px;position:relative;display:grid;grid-template-columns:.72fr 1.28fr;gap:40px;align-items:center;overflow:hidden;border-radius:34px;padding:54px;background:radial-gradient(circle at 80% 20%,rgba(89,197,184,.13),transparent 30%),#0b2928;color:#fff}.showcase-copy{position:relative;z-index:4;max-width:420px}.showcase-eyebrow{color:#8ee0d5}.showcase-copy h2{font-size:clamp(2.8rem,5vw,4.8rem);line-height:.94;letter-spacing:-.06em;margin:12px 0 18px}.showcase-copy p{color:#b8ccca;max-width:380px;margin:0 0 28px}.showcase-copy a{color:#fff;font-weight:820}.showcase-copy a span{color:#8ee0d5;margin-left:6px}.screen-showcase{position:relative;height:520px}.screen{position:absolute;margin:0;width:42%;border-radius:26px;overflow:hidden;border:5px solid rgba(255,255,255,.93);box-shadow:0 30px 65px rgba(0,0,0,.32);background:#fff}.screen img{display:block;width:100%}.screen-one{left:0;top:72px;transform:rotate(-6deg)}.screen-two{left:28%;top:8px;z-index:3}.screen-three{right:-2%;top:86px;transform:rotate(7deg)}
    .path-section{background:var(--bg)}.path-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.path-card{position:relative;overflow:hidden;min-height:360px;border-radius:28px;padding:30px;display:flex;flex-direction:column;justify-content:space-between;border:1px solid var(--line)}.path-top{display:flex;justify-content:space-between;gap:18px;font-size:.78rem;font-weight:820;text-transform:uppercase;letter-spacing:.08em}.path-card>div:nth-child(2){max-width:440px}.path-card h3{font-size:clamp(2rem,3.2vw,3.2rem);line-height:.98;letter-spacing:-.05em;margin:0 0 12px}.path-card p{margin:0}.path-personal{background:#0b2928;color:#fff;border-color:#0b2928}.path-personal p{color:#b4c7c5}.path-personal .path-top{color:#8ee0d5}.path-corporate{background:#fff}.path-corporate p{color:var(--muted)}.path-corporate .path-top{color:var(--teal-dark)}
    .video-section{background:#fff}.section-link{justify-self:end;color:var(--teal-dark);font-weight:820;align-self:end}.video-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.video-card{border:1px solid var(--line);border-radius:22px;overflow:hidden;background:#fff;box-shadow:var(--shadow-sm)}.video-wrapper{position:relative;width:100%;aspect-ratio:16/10;background:#102022}.video-wrapper iframe{position:absolute;inset:0;width:100%;height:100%;border:0}.video-title{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:16px 17px 18px}.video-title h3{margin:0;font-size:1.04rem}.video-title span{color:var(--teal-dark);font-size:.78rem;font-weight:800}
    .guides-section{background:var(--bg)}.guide-tiles{border-top:1px solid var(--line-strong)}.guide-tiles a{display:grid;grid-template-columns:150px 1fr 56px;gap:24px;align-items:center;min-height:112px;border-bottom:1px solid var(--line-strong)}.guide-tiles span{color:var(--teal-dark);font-size:.76rem;font-weight:820;text-transform:uppercase;letter-spacing:.08em}.guide-tiles strong{font-size:clamp(1.2rem,2vw,1.75rem);letter-spacing:-.03em;line-height:1.1}.guide-tiles b{color:#9aaaa7;font-size:.74rem;justify-self:end}
    .final-cta{padding:84px 0;background:#102022;color:#fff}.final-cta-inner{display:flex;align-items:end;justify-content:space-between;gap:60px}.final-eyebrow{color:#8ee0d5}.final-cta h2{font-size:clamp(3rem,6vw,5.8rem);line-height:.92;letter-spacing:-.065em;margin:12px 0 0}.final-actions{display:grid;gap:16px;min-width:190px}.final-actions>a:not(.btn){color:#aec0be;font-size:.86rem;font-weight:750;text-align:center}.final-button{background:#fff;color:#102022;border-color:#fff;box-shadow:none}

    @media(max-width:1000px){.home-hero-grid{grid-template-columns:1fr}.hero-copy{max-width:780px}.product-stage{max-width:680px;width:100%;margin:0 auto}.showcase-shell{grid-template-columns:1fr;padding-bottom:0}.showcase-copy{max-width:600px}.screen-showcase{width:min(100%,720px);justify-self:center}}
    @media(max-width:820px){.home-hero{padding:48px 0 54px}.section-intro{grid-template-columns:1fr;gap:12px}.section-intro>p,.section-link{justify-self:start}.system-grid,.path-grid,.video-grid{grid-template-columns:1fr}.signal-inner{gap:12px;overflow-x:auto;justify-content:flex-start;white-space:nowrap}.final-cta-inner{display:grid;align-items:start}.final-actions{width:max-content}}

    @media(max-width:620px){
      .home-hero{padding:26px 0 30px;background:radial-gradient(circle at 90% 18%,rgba(16,153,141,.14),transparent 31%),linear-gradient(180deg,#f5faf8 0%,#fbfcfa 100%)}
      .home-hero::before{width:350px;height:350px;right:-220px;top:-115px}
      .home-hero-grid{gap:0}
      .launch-pill{padding:6px 10px;font-size:.76rem}
      .hero-copy h1{font-size:clamp(2.65rem,11.7vw,3.35rem);line-height:.94;letter-spacing:-.063em;margin:16px 0 18px;max-width:100%}
      .hero-copy h1 em{display:inline;color:var(--teal-dark)}
      .hero-lead{font-size:1rem;line-height:1.48;max-width:96%;margin-top:18px}
      .mobile-app-glimpse{display:block;position:relative;height:218px;margin:0 -4px;border-radius:24px;overflow:hidden;background:radial-gradient(circle at 78% 10%,rgba(81,203,188,.22),transparent 34%),#0b2928;box-shadow:0 22px 48px rgba(11,41,40,.17)}
      .glimpse-copy{position:absolute;left:18px;top:18px;z-index:8;display:grid;gap:2px;color:#fff;max-width:44%}.glimpse-copy span{font-size:.68rem;text-transform:uppercase;letter-spacing:.1em;color:#8ee0d5;font-weight:850}.glimpse-copy strong{font-size:1.08rem;line-height:1.05;letter-spacing:-.03em}.glimpse-copy small{font-size:.68rem;color:#b6cac7;margin-top:4px}
      .glimpse-main,.glimpse-side{position:absolute;border-radius:18px;border:4px solid rgba(255,255,255,.96);box-shadow:0 18px 36px rgba(0,0,0,.3)}.glimpse-main{width:39%;right:14%;top:18px;z-index:4}.glimpse-side{width:31%;right:-7%;top:58px;transform:rotate(7deg);opacity:.9}
      .hero-actions{margin-top:18px;display:flex;align-items:center;gap:16px}.hero-primary{min-height:48px;padding:.78rem 1rem;flex:1}.hero-secondary{padding:10px 0;white-space:nowrap;font-size:.84rem}
      .hero-proof{margin-top:18px;gap:7px;font-size:.68rem;overflow:hidden}.hero-proof span:last-child,.hero-proof i:nth-last-child(2){display:none}
      .product-stage{display:none}
      .signal-bar{display:none}
      .section{padding:58px 0}.section-intro{margin-bottom:24px}.section-intro h2{font-size:2.25rem}
      .system-card{min-height:145px;grid-template-columns:34px 1fr auto;padding:20px;gap:12px}.system-card h3{font-size:1.4rem}.system-card p{font-size:.88rem}
      .showcase-section{padding:0 0 58px}.showcase-shell{min-height:610px;border-radius:26px;padding:32px 22px 0}.showcase-copy h2{font-size:3rem}.screen-showcase{height:400px}.screen{width:50%}.screen-one{left:-12%;top:100px}.screen-two{left:25%;top:28px}.screen-three{right:-12%;top:112px}
      .path-card{min-height:300px;padding:24px}.path-card h3{font-size:2.25rem}
      .guide-tiles a{grid-template-columns:1fr 35px;gap:7px 16px;padding:18px 0}.guide-tiles span{grid-column:1}.guide-tiles strong{grid-column:1}.guide-tiles b{grid-column:2;grid-row:1/3}
      .final-cta{padding:64px 0}.final-cta h2{font-size:clamp(3rem,15vw,4.6rem)}.final-actions,.final-button{width:100%}
    }
  </style>
</BaseLayout>