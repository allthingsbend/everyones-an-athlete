---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = 'Contact Everyone’s an Athlete';
const description = 'Contact Everyone’s an Athlete for app questions, corporate wellness, fitness, nutrition, recovery and mental performance support.';
---
<BaseLayout title={title} description={description}>
<section class="page-hero"><div class="container"><div class="eyebrow">Contact</div><h1>Let’s start a useful conversation.</h1><p class="lead">Everyone’s an Athlete is coming soon. Reach out for launch updates, corporate wellness planning, educational partnerships or general questions.</p><div class="hero-actions"><a class="btn" href="mailto:Dr.Cain@hhmovement.com?subject=Everyone%27s%20an%20Athlete%20inquiry">Email Dr. Cain</a><a class="btn secondary" href="/corporate-wellness/">Corporate Wellness</a></div></div></section>
<section class="content"><div class="container"><article>
<h2>Get in touch</h2><p>Email <a href="mailto:Dr.Cain@hhmovement.com">Dr.Cain@hhmovement.com</a>. To help us respond efficiently, include your name, organization if relevant, and what you would like to discuss.</p>
<div class="grid two"><div class="card"><h3>App launch updates</h3><p>Ask to be notified as Everyone’s an Athlete moves toward launch.</p></div><div class="card"><h3>Corporate wellness</h3><p>Share your team size, location or remote-work setup and the outcomes you want to support.</p></div><div class="card"><h3>Education and partnerships</h3><p>Connect about teams, schools, companies, coaches or aligned organizations.</p></div><div class="card"><h3>General questions</h3><p>Ask about our training, body care, mental performance or fuel and wellness resources.</p></div></div>
<p class="source-note">Please do not send urgent medical information by email. For a medical emergency, contact local emergency services.</p>
</article></div></section>
</BaseLayout>
