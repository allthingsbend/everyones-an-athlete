---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Fitness, Nutrition, Recovery & Wellness App';
const description = 'Everyone’s an Athlete is a simple fitness and wellness app focused on training, recovery, nutrition, and healthy habits.';
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <div class="eyebrow">Health & Human Movement Inc.</div>
        <h1>Smarter training, recovery, nutrition and wellness in one simple app.</h1>
        <p class="lead">Everyone’s an Athlete helps people build sustainable health through guided movement, strength training, recovery support, and practical nutrition education.</p>
        <div class="hero-actions">
          <a class="btn" href="https://www.hhmovement.com/#join-now">Open the App</a>
          <a class="btn secondary" href="/guides/">Check Out Our Guides</a>
        </div>
      </div>

      <div class="coming-soon-card">
        <div class="coming-soon-badge">Coming Soon</div>
        <h2>Everyone’s an Athlete App</h2>
        <p>Training, recovery, nutrition, and wellness tools are coming soon.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="eyebrow">Core pillars</div>
      <h2>Built around sustainable health and performance.</h2>
      <div class="grid two pillar-grid">
        <a class="card" href="/training/">
          <span class="pill">Training</span>
          <h3>Training</h3>
          <p>Structured strength sessions, follow-along exercise videos, weekly plans, and foundational movement skills.</p>
        </a>

        <a class="card" href="/fuel-wellness/">
          <span class="pill orange">Nutrition</span>
          <h3>Fuel & Wellness</h3>
          <p>Guidance on nutrition, sleep, hydration, protein, recovery, and sustainable wellness habits.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container split">
      <div>
        <div class="eyebrow">Guides</div>
        <h2>Helpful wellness guides focused on fitness, recovery, nutrition and long-term health.</h2>
        <p class="lead small">Explore practical articles on fitness apps, workplace wellness, recovery, nutrition, ergonomics, and whole-person health.</p>
        <a class="btn" href="/guides/">Check Out Our Guides</a>
      </div>

      <div class="coming-soon-card small-card">
        <div class="coming-soon-badge">More Coming Soon</div>
        <h2>New Guides & Tools</h2>
        <p>Fresh resources for training, recovery, nutrition, and everyday wellness are on the way.</p>
      </div>
    </div>
  </section>
</BaseLayout>
