---
const {
  eyebrow,
  heading,
  lead,
  primaryLabel = 'Explore the App',
  primaryHref = '/fitness-apps/',
  secondaryLabel = 'Browse Guides',
  secondaryHref = '/guides/',
  features = [],
  accent = 'blue',
  image = '/images/app/screenshot-1.png',
  image2 = '/images/app/screenshot-2.png',
  visualTitle = 'Built to follow',
  visualText = 'Clear direction, useful video guidance and practical support around the work.'
} = Astro.props;
---
<section class={`topic-hero topic-${accent}`}>
  <div class="container topic-hero-grid">
    <div class="topic-copy">
      <div class="topic-kicker"><span></span>{eyebrow}</div>
      <h1>{heading}</h1>
      <p class="topic-lead">{lead}</p>
      <div class="topic-actions">
        <a class="btn" href={primaryHref}>{primaryLabel} <span>→</span></a>
        <a class="topic-secondary" href={secondaryHref}>{secondaryLabel}</a>
      </div>
      {features.length > 0 && <div class="topic-features">{features.map((feature) => <span>{feature}</span>)}</div>}
    </div>

    <div class="topic-visual">
      <div class="topic-visual-copy">
        <span>{eyebrow}</span>
        <strong>{visualTitle}</strong>
        <p>{visualText}</p>
      </div>
      <img class="topic-phone" src={image} alt={`${eyebrow} app preview`} loading="eager" />
    </div>
  </div>
</section>

<style>
  .topic-hero { --hub-accent:#5672a8; --hub-soft:#eef2f8; position:relative; padding:70px 0; background:#f7f8fa; border-bottom:1px solid var(--line); overflow:hidden; }
  .topic-teal { --hub-accent:#477f7a; --hub-soft:#edf4f3; }
  .topic-purple { --hub-accent:#766b98; --hub-soft:#f2f0f7; }
  .topic-orange { --hub-accent:#a77a43; --hub-soft:#f7f2ea; }
  .topic-coral { --hub-accent:#a76662; --hub-soft:#f7efee; }
  .topic-dark { --hub-accent:#5672a8; --hub-soft:#eef2f8; }
  .topic-blue { --hub-accent:#5672a8; --hub-soft:#eef2f8; }
  .topic-hero::after { content:""; position:absolute; width:560px; height:560px; border-radius:50%; right:-230px; top:-260px; background:var(--hub-soft); opacity:.8; }
  .topic-hero-grid { position:relative; z-index:1; display:grid; grid-template-columns:minmax(0,1fr) minmax(380px,.82fr); gap:64px; align-items:center; min-width:0; }
  .topic-copy { min-width:0; }
  .topic-kicker { display:flex; align-items:center; gap:10px; color:var(--hub-accent); font-weight:850; font-size:.76rem; letter-spacing:.14em; text-transform:uppercase; }
  .topic-kicker span { width:8px; height:8px; border-radius:50%; background:var(--hub-accent); box-shadow:0 0 0 6px color-mix(in srgb,var(--hub-accent) 10%,transparent); }
  .topic-copy h1 { font-size:clamp(3rem,5vw,5rem); line-height:.98; letter-spacing:-.06em; margin:18px 0 20px; max-width:760px; text-wrap:balance; overflow-wrap:break-word; }
  .topic-lead { max-width:650px; color:#667078; font-size:1.1rem; line-height:1.55; margin:0; }
  .topic-actions { display:flex; align-items:center; flex-wrap:wrap; gap:18px; margin-top:28px; }
  .topic-actions .btn { background:#273750; border-color:#273750; box-shadow:0 12px 28px rgba(39,55,80,.14); }
  .topic-actions .btn span { color:#b8c8e5; }
  .topic-secondary { color:var(--hub-accent); font-weight:800; }
  .topic-features { display:flex; flex-wrap:wrap; gap:8px; margin-top:28px; }
  .topic-features span { border:1px solid #d9dde3; background:rgba(255,255,255,.72); border-radius:999px; padding:7px 11px; color:#657078; font-size:.78rem; font-weight:760; }
  .topic-visual { position:relative; min-height:440px; overflow:hidden; border-radius:30px; background:linear-gradient(145deg,#303f59,#202d43); box-shadow:0 30px 65px rgba(31,44,65,.16); }
  .topic-visual::after { content:""; position:absolute; width:280px; height:280px; border-radius:50%; right:-90px; top:-90px; background:color-mix(in srgb,var(--hub-accent) 42%,transparent); opacity:.45; }
  .topic-visual-copy { position:absolute; z-index:3; left:28px; top:30px; width:43%; color:#fff; }
  .topic-visual-copy > span { color:#b8c8e5; font-size:.7rem; font-weight:850; text-transform:uppercase; letter-spacing:.13em; }
  .topic-visual-copy strong { display:block; font-size:1.65rem; line-height:1.04; letter-spacing:-.04em; margin:8px 0; }
  .topic-visual-copy p { color:#c6ced9; font-size:.86rem; line-height:1.45; margin:0; }
  .topic-phone { position:absolute; z-index:2; width:54%; right:-2%; top:48px; border-radius:24px 0 0 24px; border:5px solid rgba(255,255,255,.94); border-right:0; box-shadow:0 25px 50px rgba(0,0,0,.26); }

  @media(max-width:980px){ .topic-hero-grid{grid-template-columns:1fr;gap:36px}.topic-visual{max-width:700px;width:100%} }
  @media(max-width:620px){
    .topic-hero{padding:42px 0 44px}.topic-hero::after{width:330px;height:330px;right:-190px;top:-120px}
    .topic-hero-grid{gap:30px;width:min(100% - 40px,1180px)}
    .topic-copy h1{font-size:clamp(2.45rem,10.8vw,3.35rem);line-height:.99;letter-spacing:-.052em;margin:16px 0 16px;max-width:100%;text-wrap:pretty}
    .topic-lead{font-size:1rem;line-height:1.52;max-width:100%}
    .topic-actions{display:grid;grid-template-columns:1fr;margin-top:22px;gap:11px}.topic-actions .btn{width:100%;min-height:52px}.topic-secondary{display:block;text-align:center;padding:7px 4px}
    .topic-features{margin-top:18px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.topic-features span{text-align:center;padding:7px 5px;font-size:.72rem;white-space:normal}
    .topic-visual{min-height:300px;border-radius:24px}.topic-visual-copy{left:20px;top:22px;width:43%}.topic-visual-copy strong{font-size:1.22rem}.topic-visual-copy p{display:none}.topic-phone{width:58%;right:-1%;top:30px;border-radius:20px 0 0 20px}
  }
</style>