---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = 'Fuel and Wellness App';
const description = 'Evidence-based nutrition and wellness guidance for training, recovery, sleep, stress and overall wellbeing.';
---
<BaseLayout title={title} description={description}>
<section class="page-hero orange-bg"><div class="container"><div class="eyebrow orange-text">Fuel & Wellness</div><h1>Nutrition and lifestyle guidance that supports performance.</h1><p class="lead">Fuel & Wellness connects training with practical nutrition, protein education, sleep, stress, hydration and recovery habits.</p></div></section>
<section class="content"><div class="container"><article><h2>Why this pillar is important</h2><p>People often separate workouts from nutrition, sleep and stress. This pillar helps explain that performance and wellbeing are shaped by the full lifestyle system, not just the workout itself.</p><div class="callout orange-border">Content angle: better fuel supports better training, recovery and long-term health.</div><h2>Recommended content under this pillar</h2><ul><li><a href="/nutrition/why-nutrition-is-important-for-athletes/">Why nutrition is important for athletes</a></li><li><a href="/fitness-apps/best-fitness-apps-with-nutrition/">Best fitness apps with nutrition tracking</a></li><li><a href="/guides/fitness-nutrition-mental-health-recovery-app/">All-in-one fitness and wellness app guide</a></li></ul></article></div></section>
</BaseLayout>
