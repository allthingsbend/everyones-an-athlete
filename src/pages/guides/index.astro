---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Fitness, Nutrition, Recovery and Mental Wellness Guides';
const description = 'Explore practical guides on training, recovery, nutrition, mental performance, workplace wellness and fitness apps.';

const guides = [
  {
    title: 'Best Fitness Apps with Nutrition Support',
    description: 'What to look for in a fitness app that combines workout guidance with nutrition education and healthier habits.',
    url: '/fitness-apps/best-fitness-apps-with-nutrition/',
    category: 'Fitness Apps',
    featured: true
  },
  {
    title: 'All-in-One Physical and Mental Health App',
    description: 'Why fitness, recovery, stress management and mindset tools work better when they are part of one connected system.',
    url: '/fitness-apps/all-in-one-physical-mental-health-app/',
    category: 'Fitness Apps',
    featured: true
  },
  {
    title: 'Best Fitness App for Beginners',
    description: 'What makes a fitness app beginner-friendly, including guided workouts, simple progression, recovery support and useful tracking.',
    url: '/fitness-apps/best-fitness-app-for-beginners/',
    category: 'Fitness Apps',
    featured: true
  },
  {
    title: 'Fitness Apps with Workout Videos',
    description: 'How guided workout videos help people train with more confidence, consistency and structure.',
    url: '/fitness-apps/workout-videos/',
    category: 'Training'
  },
  {
    title: 'Beginner Strength Training Program',
    description: 'A practical two-day full-body plan with beginner exercise options, progression guidance and recovery advice.',
    url: '/training/beginner-strength-training-program/',
    category: 'Training'
  },
  {
    title: 'Dumbbell-Only Workout Plan',
    description: 'A full-body dumbbell workout plan for home or a small gym, with simple progression guidance and no bench required.',
    url: '/training/dumbbell-only-workout-plan/',
    category: 'Training'
  },
  {
    title: '3-Day Full-Body Workout Plan',
    description: 'A three-day strength plan built around squats, hinges, presses, rows, single-leg work and practical recovery.',
    url: '/training/3-day-full-body-workout-plan/',
    category: 'Training'
  },
  {
    title: 'Why Nutrition Is Important for Athletes',
    description: 'How protein, hydration, meal timing and everyday food choices support performance, recovery and long-term health.',
    url: '/nutrition/why-nutrition-is-important-for-athletes/',
    category: 'Nutrition'
  },
  {
    title: 'Pre-Workout Meal Guide',
    description: 'Simple ideas for what to eat before strength training, cardio or recreational exercise without overcomplicating timing.',
    url: '/nutrition/pre-workout-meal-guide/',
    category: 'Nutrition'
  },
  {
    title: 'High-Protein Breakfast Ideas for Athletes',
    description: 'Practical high-protein breakfast ideas using eggs, yogurt, oats, cottage cheese, tofu and other simple foods.',
    url: '/nutrition/high-protein-breakfast-for-athletes/',
    category: 'Nutrition'
  },
  {
    title: 'Mobility and Recovery After Workouts',
    description: 'Simple recovery habits and mobility routines that help people feel better between workouts.',
    url: '/recovery/mobility-recovery-after-workouts/',
    category: 'Recovery'
  },
  {
    title: '10-Minute Full-Body Mobility Routine',
    description: 'A simple equipment-free routine for ankles, hips, upper back and shoulders, with easy modifications.',
    url: '/recovery/10-minute-mobility-routine/',
    category: 'Recovery'
  },
  {
    title: 'Hip Mobility Routine for Tight Hips',
    description: 'A short hip routine using controlled rotation, lunges, adductor work and active range-of-motion exercises.',
    url: '/recovery/hip-mobility-routine-for-tight-hips/',
    category: 'Recovery'
  },
  {
    title: 'Shoulder Mobility Routine for Lifters',
    description: 'Prepare the upper back, shoulder blades and shoulder rotation for pressing and pulling workouts.',
    url: '/recovery/shoulder-mobility-routine-for-lifters/',
    category: 'Recovery'
  },
  {
    title: 'Mental Performance Training for Athletes',
    description: 'A practical guide to focus, breathing, awareness, confidence and building the mindset behind better performance.',
    url: '/mental-performance/mental-performance-training-for-athletes/',
    category: 'Mental Performance'
  },
  {
    title: 'Breathing Exercises for Athletes',
    description: 'Three practical breathing routines for pre-performance focus, between-effort resets and post-training recovery.',
    url: '/mental-performance/breathing-exercises-for-athletes/',
    category: 'Mental Performance'
  },
  {
    title: 'Corporate Fitness and Wellness Programs',
    description: 'How companies can support employees with movement, recovery, nutrition, ergonomics and mental wellness resources.',
    url: '/corporate-wellness/',
    category: 'Corporate Wellness'
  },
  {
    title: 'Employee Wellness App Guide',
    description: 'What an employee wellness app should include, how to evaluate one and how to support meaningful participation.',
    url: '/corporate-wellness/employee-wellness-app/',
    category: 'Corporate Wellness'
  },
  {
    title: 'Wellness Challenges for Employees',
    description: 'Twelve practical workplace wellness challenge ideas for office, remote and hybrid teams without relying on weight-loss competitions.',
    url: '/corporate-wellness/wellness-challenges-for-employees/',
    category: 'Corporate Wellness'
  },
  {
    title: 'Workplace Ergonomics Guide',
    description: 'Desk setup, posture, movement breaks and simple recovery habits for people who sit for long periods.',
    url: '/workplace-wellness/workplace-ergonomics/',
    category: 'Workplace Wellness'
  },
  {
    title: 'Desk Mobility Routine',
    description: 'A short, adaptable movement break for the neck, shoulders, upper back, hips and ankles during the workday.',
    url: '/workplace-wellness/desk-mobility-routine/',
    category: 'Workplace Wellness'
  }
];

const featuredGuides = guides.filter((guide) => guide.featured);
const allGuides = guides.filter((guide) => !guide.featured);
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container">
      <div class="eyebrow">Guides</div>
      <h1>Fitness, nutrition, recovery and mental wellness guides.</h1>
      <p class="lead">Explore practical guides built around training, recovery, nutrition and mental performance, plus deeper resources for fitness apps and workplace wellness.</p>
      <div class="hero-actions">
        <a class="btn" href="/contact/">Get Launch Updates</a>
        <a class="btn secondary" href="/about/">Learn About the Mission</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="eyebrow">Featured Guides</div>
      <h2>Start here.</h2>
      <div class="grid three">
        {featuredGuides.map((guide) => (
          <a class="card" href={guide.url}>
            <span class="pill">{guide.category}</span>
            <h3>{guide.title}</h3>
            <p>{guide.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="eyebrow">All Guides</div>
      <h2>Browse the full guide library.</h2>
      <div class="grid three">
        {allGuides.map((guide) => (
          <a class="card" href={guide.url}>
            <span class="pill">{guide.category}</span>
            <h3>{guide.title}</h3>
            <p>{guide.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
